# Copiar para .env.local e preencher. O .env.local nao vai para o git.
# Provedor do e-mail do dominio: Hostinger (MX = mx1/mx2.hostinger.com).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=alo@madebyfelipe.com.br
SMTP_PASSWORD=

# Twenty CRM (Core API) — usado por app/api/diagnostico/route.ts.
# Chave em Settings -> API & Webhooks. Sem ela, o form so manda e-mail.
TWENTY_BASE_URL=https://crm.madebyfelipe.agency
TWENTY_API_KEY=
