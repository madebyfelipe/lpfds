# Copiar para .env.local e preencher. O .env.local nao vai para o git.
# Provedor do e-mail do dominio: Hostinger (MX = mx1/mx2.hostinger.com).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=alo@madebyfelipe.com.br
SMTP_PASSWORD=

# Twenty CRM (Core API) — usado por app/api/diagnostico/route.ts.
# Chave em Settings -> API & Webhooks. Sem ela, o form so manda e-mail.
TWENTY_BASE_URL=https://crm.madebyfelipe.agency
TWENTY_API_KEY=

# Segredo do CRON dos lembretes do webinar (7/3/1 dias antes) — app/api/webinar/reminders.
# O Vercel Cron manda como "Authorization: Bearer <CRON_SECRET>". Sem ele a rota
# recusa (503), para nao ficar um gatilho aberto. Gerar um valor aleatorio e
# replicar no painel da Vercel (Environment Variables).
CRON_SECRET=

# (Legado — nao usado) Webhook do workflow de confirmacao do webinar no Twenty.
# A confirmacao passou a sair pelo SMTP do dominio (o Twenty nao tem caixa
# conectada, entao o Send Email dele fica invalido). Manter vazio.
TWENTY_WEBINAR_WEBHOOK=

# ---------------------------------------------------------------------------
# Prospecção ativa (docs/prospeccao.md) — rotina noturna + painel + disparo.
# ---------------------------------------------------------------------------
# Senha do /painel (HTTP Basic). Sem ela o painel não abre.
PAINEL_USUARIO=felipe
PAINEL_SENHA=
# Token que a rotina noturna manda em "Authorization: Bearer". Gerar aleatório
# (ex.: openssl rand -hex 32) e colar TAMBÉM nas variáveis do ambiente do
# Claude Code (claude.ai/code → ambiente → Environment variables).
PROSPECCAO_TOKEN=
# Assina o link de descadastro. Gerar aleatório; NUNCA trocar depois do 1º
# envio (os links já enviados param de funcionar).
PROSPECCAO_SECRET=
# 1º dia de disparo (YYYY-MM-DD). Vazio = nada sai (modo ensaio). O limite
# diário sobe a partir desta data (aquecimento): 5, 7, 9… até 30.
PROSPECCAO_INICIO=
# "revisao" (só sai o aprovado no painel) | "automatico" (sai o que você não
# vetar em 4h). Começar em revisao.
PROSPECCAO_MODO=revisao
# "1" pausa tudo. O painel também pausa, sem redeploy.
PROSPECCAO_PAUSADO=
# Pool de caixas de prospecção (recomendado: domínio secundário). JSON, uma
# entrada por caixa, cada uma com rampa própria a partir do seu "inicio":
# [{"email":"felipe@madebyfelipe.agency","senha":"...","inicio":"2026-10-20","teto":30}]
# Campos opcionais: nome, teto, smtpHost, smtpPort, imapHost, imapPort.
PROSPECCAO_CAIXAS=
# Alternativa para UMA caixa dedicada. Vazio (e sem PROSPECCAO_CAIXAS) = usa a
# caixa do site (SMTP_*).
PROSPECCAO_SMTP_USER=
PROSPECCAO_SMTP_PASSWORD=
PROSPECCAO_SMTP_HOST=
PROSPECCAO_SMTP_PORT=
PROSPECCAO_IMAP_HOST=
PROSPECCAO_REMETENTE_NOME=Felipe | Made by Felipe
# Site para o link de descadastro (precisa ser o domínio onde o Next roda).
PROSPECCAO_SITE_URL=https://madebyfelipe.com.br
# Para onde o DMARC sugerido no painel manda o relatório (rua).
PROSPECCAO_DMARC_RUA=
# Link de agendamento (Cal.com, Calendly, Google Agenda) que a IA põe na
# resposta a quem demonstrou interesse.
PROSPECCAO_LINK_AGENDA=
# Opcional: Claude API para a IA do painel (reescrever e-mail com instrução,
# ler respostas e rascunhar a réplica). Sem ela, a rotina noturna faz isso.
ANTHROPIC_API_KEY=
