# Copiar para .env.local e preencher. O .env.local nao vai para o git.
# Provedor do e-mail do dominio: Hostinger (MX = mx1/mx2.hostinger.com).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=alo@madebyfelipe.com.br
SMTP_PASSWORD=

# Twenty CRM (Core API) — usado por app/api/diagnostico/route.ts.
# Chave em Settings -> API & Webhooks. Sem ela, o form so manda e-mail.
TWENTY_BASE_URL=https://crm.madebyfelipe.agency
TWENTY_API_KEY=

# Segredo do CRON dos lembretes do webinar (7/3/1 dias antes) — app/api/webinar/reminders.
# O Vercel Cron manda como "Authorization: Bearer <CRON_SECRET>". Sem ele a rota
# recusa (503), para nao ficar um gatilho aberto. Gerar um valor aleatorio e
# replicar no painel da Vercel (Environment Variables).
CRON_SECRET=

# (Legado — nao usado) Webhook do workflow de confirmacao do webinar no Twenty.
# A confirmacao passou a sair pelo SMTP do dominio (o Twenty nao tem caixa
# conectada, entao o Send Email dele fica invalido). Manter vazio.
TWENTY_WEBINAR_WEBHOOK=
